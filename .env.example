# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# App Settings
APP_ENV=development

# Groq - Agents 2 and 5
GROQ_API_KEY=

# Agent 6 - Jira Service Management (leave disabled for local-only dispatch)
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TRO
JIRA_ISSUE_TYPE=Task

# Run Agents 4-6 automatically when clarification reaches READY
AUTO_DISPATCH_ON_READY=true

# Conversation orchestrator: langgraph (default) or service (rollback)
ORCHESTRATOR=langgraph

# Agent 4: raw cosine at/above which an open ticket is suggested as a duplicate
# (the user confirms first; 0.87 from results/agent4_live_calibration.md)
# CORR_DUP_THRESHOLD=0.87

# Agent 4: a DUPLICATE needs at least this many extracted fields in the request
# and in the candidate ticket (default 2; clusters are not affected)
# CORR_DUP_MIN_FIELDS=2
